# Cadence runtime configuration locator. Non-secret runtime values live in
# the selected canonical JSON configuration.
CADENCE_CONFIG_PATH=../../config/cadence.runtime.example.json

# Secret values are supplied out of band and are never committed.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
CADENCE_LOCAL_DEV_PASSWORD=

# Adapter-only transport binding.
PORT=3000
