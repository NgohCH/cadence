# Cadence API / worker configuration
#
# CADENCE_ENV must always be explicit:
#   local - local Supabase Docker only
#   qa    - hosted QA Supabase project
#   beta  - hosted Beta Supabase project
#
# For local development, CADENCE_SUPABASE_PROJECT_REF must remain empty.
# For qa/beta, set it to the exact hosted Supabase project ref.

CADENCE_ENV=local

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key

CADENCE_SUPABASE_PROJECT_REF=

WEB_ORIGIN=http://localhost:5173

# Local bootstrap identity. Used only by `local:bootstrap`.
CADENCE_LOCAL_DEV_EMAIL=local.admin@cadence.test
CADENCE_LOCAL_DEV_PASSWORD=choose-a-local-only-password
