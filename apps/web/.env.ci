# Non-secret environment used only to compile and validate
# the Cadence browser application in CI.
#
# It deliberately represents a local-safe configuration.
# No Supabase service/secret key belongs here.

VITE_CADENCE_ENV=local
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLIC_KEY=ci-browser-key-not-for-runtime-use
VITE_SUPABASE_PROJECT_REF=
VITE_PROJECT_ID=10ca3000-0000-4000-8000-000000000001
