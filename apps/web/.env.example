# Cadence browser configuration.
#
# Local development:
#   .env.development.local
#
# QA development:
#   .env.qa.local
#
# Mode-specific runtime files are ignored by Git.
#
# Never place SUPABASE_SECRET_KEY or any other
# server-side credential in a VITE_ variable.

VITE_CADENCE_ENV=local
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLIC_KEY=your-browser-safe-publishable-key
VITE_SUPABASE_PROJECT_REF=
VITE_PROJECT_ID=10ca3000-0000-4000-8000-000000000001
