{
  "name": "cadence",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "api:test": "npm --prefix apps/api test",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "pilot:preflight": "npm --prefix apps/api run pilot:preflight --",
    "pilot:execute": "npm --prefix apps/api run pilot:execute --",
    "web:lint": "npm --prefix apps/web run lint",
    "web:build": "npm --prefix apps/web run build",
    "db:local:start": "npx supabase start",
    "db:local:status": "npx supabase status",
    "db:local:reset": "npm --prefix apps/api run env:local:check && npx supabase db reset",
    "db:qa:check": "npm --prefix apps/api run supabase:target:check -- --env qa",
    "db:qa:preflight": "npm --prefix apps/api run supabase:db:push -- --env qa --dry-run",
    "db:qa:push": "npm --prefix apps/api run supabase:db:push -- --env qa",
    "db:local:bootstrap": "npm --prefix apps/api run local:bootstrap",
    "db:local:rebuild": "npm run db:local:reset && npm run db:local:bootstrap",
    "web:build:ci": "npm --prefix apps/web run build:ci",
    "cadence:setup:check": "npm --prefix apps/api run vs005:deploy:plan",
    "cadence:deploy:plan": "npm --prefix apps/api run vs005:deploy:plan",
    "cadence:deploy:apply": "npm --prefix apps/api run vs005:deploy:apply",
    "cadence:deploy:verify": "npm --prefix apps/api run vs005:deploy:verify",
    "cadence:rollback": "npm --prefix apps/api run vs005:rollback --",
    "quality": "npm run api:typecheck && npm run api:test && npm run web:lint && npm run web:build:ci",
    "test": "npm run quality",
    "db:beta:check": "npm --prefix apps/api run supabase:target:check -- --env beta",
    "db:beta:preflight": "npm --prefix apps/api run supabase:db:push -- --env beta --dry-run",
    "db:beta:push": "npm --prefix apps/api run supabase:db:push -- --env beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NgohCH/cadence.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NgohCH/cadence/issues"
  },
  "homepage": "https://github.com/NgohCH/cadence#readme",
  "devDependencies": {
    "supabase": "^2.113.0"
  }
}
